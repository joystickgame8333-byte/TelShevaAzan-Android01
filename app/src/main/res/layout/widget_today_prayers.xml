<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:text="مواقيت اليوم" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_today_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textColor="#AFC3D7" android:textSize="10sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_today_fajr" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical|end" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_today_dhuhr" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical|end" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_today_asr" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical|end" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_today_maghrib" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical|end" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_today_isha" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical|end" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
</LinearLayout>
